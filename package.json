{
  "name": "payload-news-boilerplate",
  "version": "1.0.0",
  "description": "Payload CMS boilerplate for news websites",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types"
  },
  "keywords": [
    "payload",
    "cms",
    "news",
    "boilerplate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "payload": "^2.21.0",
    "express": "^4.18.2",
    "dotenv": "^16.4.5",
    "mongodb": "^6.3.0",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
